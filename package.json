{
  "name": "liufengwei-personal-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "predev": "pnpm content:prepare",
    "dev": "node scripts/dev.mjs",
    "dev:ai": "node scripts/dev-ai.mjs",
    "start": "astro dev",
    "prebuild": "pnpm content:prepare && pnpm ai:function:build",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "test:e2e": "pnpm e2e",
    "analyze": "pnpm bundle:report",
    "bundle:report": "node scripts/bundle-report.mjs",
    "screenshots:capture": "node scripts/capture-screenshots.mjs",
    "release:check": "node scripts/release-check.mjs",
    "quality": "pnpm content:check && pnpm test && pnpm typecheck && pnpm lint && pnpm format:check && pnpm ai:function:check",
    "test:content": "node --test scripts/content/*.test.mjs",
    "test:ai": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/ai/*.test.ts",
    "test:learning": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/learning/*.test.ts",
    "test:article": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/article/*.test.ts",
    "test:home": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/home/*.test.ts",
    "test:seo": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/seo/*.test.ts",
    "test:release-config": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/release/*.test.ts",
    "test:api": "pnpm --filter @lfw/server test",
    "test:integration": "pnpm --filter @lfw/server test:integration",
    "typecheck:api": "pnpm --filter @lfw/contracts typecheck && pnpm --filter @lfw/server typecheck",
    "fullstack:check": "pnpm typecheck:api && pnpm test:api",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "test": "pnpm test:content && pnpm test:ai && pnpm test:learning && pnpm test:article && pnpm test:home && pnpm test:seo && pnpm test:release-config",
    "ai:probe": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/ai-probe.mjs",
    "ai:probe:prod": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/ai-probe.mjs --production",
    "ai:inspect": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/ai-inspect.ts",
    "ai:function:build": "node scripts/build-ai-function.mjs",
    "ai:function:check": "node scripts/build-ai-function.mjs --check",
    "seo:check": "node scripts/seo-check.mjs",
    "content:new": "node scripts/content/index.mjs new",
    "content:list": "node scripts/content/index.mjs list",
    "content:check": "node scripts/content/index.mjs check",
    "content:stats": "node scripts/content/index.mjs stats",
    "content:import": "node scripts/content/index.mjs import",
    "content:prepare": "node scripts/content/index.mjs prepare",
    "new:post": "pnpm content:new"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/mdx": "7.0.5",
    "@astrojs/react": "6.0.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.1.6",
    "github-slugger": "2.0.0",
    "katex": "0.18.1",
    "mermaid": "11.16.1",
    "pagefind": "1.5.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "tailwindcss": "4.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "1.62.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "esbuild": "0.28.1",
    "fake-indexeddb": "6.2.5",
    "gray-matter": "^4.0.3",
    "pinyin-pro": "^3.28.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.3",
    "typescript": "6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vercel": "^58.4.4"
  },
  "pnpm": {
    "overrides": {
      "dompurify@<=3.4.12": "3.4.13",
      "nanoid@<3.3.17": "3.3.17"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
