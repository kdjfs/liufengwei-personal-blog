{
  "name": "liufengwei-personal-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "predev": "pnpm content:prepare",
    "dev": "node scripts/dev.mjs",
    "dev:ai": "node scripts/dev-ai.mjs",
    "start": "astro dev",
    "prebuild": "pnpm content:prepare && pnpm ai:function:build",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:content": "node --test scripts/content/*.test.mjs",
    "test:ai": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/ai/*.test.ts",
    "test": "pnpm test:content && pnpm test:ai",
    "ai:probe": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/ai-probe.mjs",
    "ai:probe:prod": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/ai-probe.mjs --production",
    "ai:function:build": "node scripts/build-ai-function.mjs",
    "content:new": "node scripts/content/index.mjs new",
    "content:list": "node scripts/content/index.mjs list",
    "content:check": "node scripts/content/index.mjs check",
    "content:stats": "node scripts/content/index.mjs stats",
    "content:import": "node scripts/content/index.mjs import",
    "content:prepare": "node scripts/content/index.mjs prepare",
    "new:post": "pnpm content:new"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/mdx": "7.0.5",
    "@astrojs/react": "6.0.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.1.6",
    "katex": "0.18.1",
    "mermaid": "11.16.0",
    "pagefind": "1.5.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "tailwindcss": "4.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.6",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "esbuild": "0.28.1",
    "gray-matter": "^4.0.3",
    "pinyin-pro": "^3.28.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.3",
    "typescript": "6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vercel": "^58.4.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
