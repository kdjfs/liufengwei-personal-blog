---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" description="你访问的页面不存在。" noindex>
  <section class="not-found container-wide">
    <div>
      <p class="not-found-code">404</p>
      <h1>这块花圃还没有内容。</h1>
      <p>地址可能改变了，也可能这篇笔记还没写下。</p>
      <a class="button primary" href="/">返回首页 →</a>
    </div>
  </section>
</BaseLayout>
