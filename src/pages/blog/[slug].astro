---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import PostCard from '@/components/blog/PostCard.astro';
import TableOfContents from '@/components/blog/TableOfContents.astro';
import ArticleLearningBar from '@/components/learning/ArticleLearningBar';
import AnnotationManager from '@/components/learning/AnnotationManager';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  formatDate,
  getPostSlug,
  getPublishedPosts,
  getReadingStats,
  getRelatedPosts,
} from '@/utils/posts';
import { getBlogCover } from '@/utils/blog-cover';

export async function getStaticPaths() {
  const posts = getPublishedPosts(await getCollection('blog'));
  return posts.map((post) => ({ params: { slug: getPostSlug(post) }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const stats = getReadingStats(post.body ?? '');
const index = posts.findIndex((item) => item.id === post.id);
const previous = posts[index + 1];
const next = posts[index - 1];
const related = getRelatedPosts(post, posts);
const seriesPosts = post.data.series
  ? posts
      .filter((item) => item.data.series === post.data.series)
      .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
  : [];
const cover = getBlogCover(post.data.slug, post.data.cover);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.publishDate}
  updatedTime={post.data.updatedDate}
>
  <div class="reading-progress" data-reading-progress aria-hidden="true"></div>
  <article
    data-article
    data-pagefind-body
    data-ai-article
    data-ai-title={post.data.title}
    data-ai-description={post.data.description}
    data-ai-category={post.data.category}
    data-ai-tags={JSON.stringify(post.data.tags)}
    data-ai-url={`/blog/${post.data.slug}`}
  >
    <header class="article-hero">
      <p class="eyebrow">
        <a href={`/categories/${encodeURIComponent(post.data.category)}`}>{post.data.category}</a>
        {
          post.data.series && (
            <>
              <span aria-hidden="true">/</span>
              <a href={`/series/${encodeURIComponent(post.data.series)}`}>{post.data.series}</a>
            </>
          )
        }
      </p>
      <h1 data-pagefind-meta="title" transition:name={`article-title-${post.data.slug}`}>
        {post.data.title}
      </h1>
      <p class="article-lead">{post.data.description}</p>
      <div class="article-meta">
        <time datetime={post.data.publishDate.toISOString()}
          >{formatDate(post.data.publishDate)}</time
        >
        <span>{stats.words} 字</span>
        <span>预计 {stats.minutes} 分钟</span>
        {post.data.updatedDate && <span>更新于 {formatDate(post.data.updatedDate)}</span>}
      </div>
      <ArticleLearningBar
        client:load
        articleSlug={post.data.slug}
        title={post.data.title}
        category={post.data.category}
      />
      <div class="tag-row" style="justify-content:center">
        {
          post.data.tags.map((tag) => (
            <a data-pagefind-meta="tag" href={`/tags/${encodeURIComponent(tag)}`}>
              #{tag}
            </a>
          ))
        }
      </div>
      <span class="sr-only" data-pagefind-meta="category">{post.data.category}</span>
    </header>
    <div class="article-cover" transition:name={`article-cover-${post.data.slug}`}>
      <Image
        src={cover.image}
        alt={`${post.data.title}文章封面`}
        widths={[720, 960, 1280, 1600]}
        sizes="(max-width: 900px) 94vw, 1120px"
        loading="eager"
        fetchpriority="high"
        format="webp"
      />
    </div>
    <div class="article-layout">
      {post.data.toc !== false && <TableOfContents headings={headings} />}
      <div class="prose"><Content /></div>
    </div>
    <AnnotationManager client:load articleSlug={post.data.slug} articleTitle={post.data.title} />
  </article>

  <footer class="article-footer">
    {
      seriesPosts.length > 0 && (
        <section class="article-series" aria-labelledby="article-series-title">
          <div class="section-kicker">
            <span>SERIES</span>
            <span>{seriesPosts.length} POSTS</span>
          </div>
          <h2 id="article-series-title">{post.data.series}</h2>
          <ol>
            {seriesPosts.map((item, seriesIndex) => (
              <li class:list={{ current: item.id === post.id }}>
                <span>{String(seriesIndex + 1).padStart(2, '0')}</span>
                {item.id === post.id ? (
                  <strong aria-current="page">{item.data.title}</strong>
                ) : (
                  <a href={`/blog/${getPostSlug(item)}`}>{item.data.title}</a>
                )}
              </li>
            ))}
          </ol>
        </section>
      )
    }
    <nav class="article-nav" aria-label="上一篇和下一篇">
      {
        previous ? (
          <a href={`/blog/${getPostSlug(previous)}`}>
            <>
              <span>← 上一篇</span>
              <strong>{previous.data.title}</strong>
            </>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/blog/${getPostSlug(next)}`}>
            <>
              <span>下一篇 →</span>
              <strong>{next.data.title}</strong>
            </>
          </a>
        )
      }
    </nav>
    {
      related.length > 0 && (
        <section class="related-posts">
          <h2>相关文章</h2>
          <div class="post-grid">
            {related.map((item) => (
              <PostCard post={item} />
            ))}
          </div>
        </section>
      )
    }
  </footer>
</BaseLayout>
