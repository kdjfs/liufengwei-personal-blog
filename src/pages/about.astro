---
import PageHeader from '@/components/common/PageHeader.astro';
import SocialIcon from '@/components/profile/SocialIcon.astro';
import { profile } from '@/config/profile';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="关于" description={`关于 ${profile.name} 的学习方向、经历与联系信息。`}>
  <PageHeader
    eyebrow="ABOUT / PROFILE"
    title="关于我"
    description="一份持续更新的个人说明：我是谁、正在做什么，以及如何与我取得联系。"
  />

  <div class="about-page container-wide" data-pagefind-body>
    <section class="about-intro" aria-labelledby="about-introduction">
      <div class="about-portrait">
        <img src={profile.avatar} width="640" height="640" alt={`${profile.name}的头像`} />
        <span><i></i> LEARNING / BUILDING</span>
      </div>
      <div>
        <p class="eyebrow">01 · INTRODUCTION</p>
        <h2 id="about-introduction">{profile.name}<small>{profile.englishName}</small></h2>
        <p class="about-role">{profile.role}</p>
        <p>{profile.bio}</p>
        <dl class="about-facts">
          <div><dt>学校</dt><dd>{profile.school}</dd></div>
          <div><dt>专业</dt><dd>{profile.major}</dd></div>
          <div><dt>毕业年份</dt><dd>{profile.graduation} 届</dd></div>
        </dl>
      </div>
    </section>

    <section class="about-section about-education" aria-labelledby="about-education">
      <div class="about-section-heading">
        <p class="eyebrow">02 · EDUCATION</p>
        <h2 id="about-education">教育经历</h2>
      </div>
      <article class="education-card">
        <time>{profile.educationPeriod}</time>
        <div><h3>{profile.school}</h3><p>{profile.major} · 本科</p></div>
        <span>{profile.graduation}</span>
      </article>
    </section>

    <section class="about-section" aria-labelledby="about-experience">
      <div class="about-section-heading">
        <p class="eyebrow">03 · EXPERIENCE</p>
        <h2 id="about-experience">实践经历</h2>
      </div>
      <ol class="experience-list">
        {
          profile.experiences.map((experience, index) => (
            <li>
              <span class="experience-index">{String(index + 1).padStart(2, '0')}</span>
              <time>{experience.period}</time>
              <div>
                <h3>{experience.organization}</h3>
                <p>{experience.role}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="about-section" aria-labelledby="about-focus">
      <div class="about-section-heading">
        <p class="eyebrow">04 · TECH FOCUS</p>
        <h2 id="about-focus">技术方向</h2>
      </div>
      <div class="focus-grid">
        {
          Object.entries(profile.techFocus).map(([group, skills], index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{group}</h3>
              <p>{skills.join(' · ')}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="about-section" aria-labelledby="about-awards">
      <div class="about-section-heading">
        <p class="eyebrow">05 · AWARDS</p>
        <h2 id="about-awards">奖项与成果</h2>
      </div>
      <ul class="award-list">
        {
          profile.awards.map((award, index) => (
            <li>
              <>
                <span>0{index + 1}</span>
                <strong>{award}</strong>
              </>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="about-section about-contact" aria-labelledby="about-contact">
      <div class="about-section-heading">
        <p class="eyebrow">06 · CONTACT</p>
        <h2 id="about-contact">保持联系</h2>
      </div>
      <div class="contact-grid">
        {
          profile.socials.map((social) => (
            <a
              href={social.href}
              target={social.external ? '_blank' : undefined}
              rel={social.external ? 'noopener noreferrer' : undefined}
              aria-label={social.label}
            >
              <SocialIcon icon={social.icon} />
              <span>{social.label}</span>
              <strong>↗</strong>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
