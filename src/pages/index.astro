---
import { getCollection } from 'astro:content';
import PostCard from '@/components/blog/PostCard.astro';
import FeaturedCategoryCard from '@/components/categories/FeaturedCategoryCard.astro';
import HomeCorner from '@/components/home/HomeCorner.astro';
import HomeDivider from '@/components/home/HomeDivider.astro';
import HomePagination from '@/components/home/HomePagination.astro';
import ContinueLearning from '@/components/learning/ContinueLearning';
import ProfileRail from '@/components/profile/ProfileRail.astro';
import { featuredCategories } from '@/config/categories';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { selectHomePosts } from '@/utils/home-feed';
import { getPublishedPosts } from '@/utils/posts';

const posts = getPublishedPosts(await getCollection('blog'));
const homePosts = selectHomePosts(posts, 10);
const categoryCards = featuredCategories.map((category) => {
  const categoryPosts = posts.filter((post) => post.data.category === category.name);
  return {
    category,
    count: categoryPosts.length,
    latestPosts: categoryPosts.slice(0, 5),
  };
});
const profileStats = {
  articles: posts.length,
  categories: new Set(posts.map((post) => post.data.category)).size,
  tags: new Set(posts.flatMap((post) => post.data.tags)).size,
  series: new Set(posts.map((post) => post.data.series).filter(Boolean)).size,
};
const pageCount = Math.max(1, Math.ceil(posts.length / 12));
---

<BaseLayout>
  <div class="home-shell">
    <ProfileRail stats={profileStats} currentPath={Astro.url.pathname} />

    <div class="home-main">
      <header class="home-welcome" aria-labelledby="home-title">
        <div>
          <p>LFW SPACE · 刘凤伟的数字花园</p>
          <h1 id="home-title">把学习写成可以反复抵达的路径。</h1>
        </div>
        <span>前端 / AI Agent / Learning</span>
      </header>

      <ContinueLearning client:idle />

      <section class="home-feed" aria-labelledby="home-articles-title" data-pagefind-body>
        <HomeDivider id="home-articles-title">文章</HomeDivider>
        <div class="home-post-list">
          {
            homePosts.map((post, index) => (
              <PostCard
                post={post}
                editorial
                reverse={index % 2 === 1}
                loading={index < 2 ? 'eager' : 'lazy'}
                revealDelay={(index % 4) * 45}
              />
            ))
          }
        </div>
        <HomePagination pageCount={pageCount} />
      </section>

      <section class="home-categories" aria-labelledby="home-categories-title">
        <HomeDivider id="home-categories-title">精选分类</HomeDivider>
        <div class="featured-category-grid home-category-grid">
          {
            categoryCards.map((item, index) => (
              <FeaturedCategoryCard {...item} priority={index < 2} revealDelay={index * 35} />
            ))
          }
        </div>
      </section>

      <HomeCorner />
    </div>
  </div>
</BaseLayout>
