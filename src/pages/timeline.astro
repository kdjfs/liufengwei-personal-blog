---
import PageHeader from '@/components/common/PageHeader.astro';
import { timeline } from '@/data/timeline';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="时间线" description="LFW Space 的个人成长与站点演进时间线。">
  <PageHeader
    eyebrow="TIMELINE"
    title="时间线"
    description="从校园、项目到实习，把真实发生的重要节点放回时间里看。"
  />
  <section class="section-compact container-narrow timeline-list" data-pagefind-body>
    {
      timeline.map((item) => (
        <article class="timeline-row">
          <time>{item.date}</time>
          <div>
            <>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </>
          </div>
        </article>
      ))
    }
  </section>
</BaseLayout>
