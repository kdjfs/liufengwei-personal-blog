---
import { ClientRouter } from 'astro:transitions';
import type { ImageMetadata } from 'astro';
import DeferredAIAssistant from '@/components/ai/DeferredAIAssistant.astro';
import Footer from '@/components/common/Footer.astro';
import Header from '@/components/common/Header.astro';
import DeferredSearch from '@/components/interactive/DeferredSearch.astro';
import SEOHead from '@/components/seo/SEOHead.astro';
import { siteConfig } from '@/config/site';
import { getPageChrome } from '@/utils/page-context';
import '@/styles/global.css';
import '@/styles/theme.css';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  canonical?: string;
  publishedTime?: Date;
  updatedTime?: Date;
  category?: string;
  tags?: string[];
  noindex?: boolean;
}

const {
  title,
  description = siteConfig.description,
  image,
  imageAlt,
  type = 'website',
  canonical,
  publishedTime,
  updatedTime,
  category,
  tags,
  noindex,
} = Astro.props;
const pageChrome = getPageChrome(Astro.url.pathname);
---

<!doctype html>
<html lang={siteConfig.language} data-theme="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#090b12" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f7fb" media="(prefers-color-scheme: light)" />
    <SEOHead
      {title}
      {description}
      {image}
      {imageAlt}
      {type}
      {canonical}
      {publishedTime}
      {updatedTime}
      {category}
      {tags}
      {noindex}
    />

    <!-- 在 CSS 下载前应用用户主题，避免首屏先亮后暗。 -->
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('lfw-theme');
        const mode = saved === 'light' || saved === 'dark' || saved === 'system' ? saved : 'system';
        const dark =
          mode === 'dark' ||
          (mode === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = mode;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
    <ClientRouter />
  </head>
  <body class={pageChrome.bodyClass}>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <div class="site-shell">
      <Header currentPath={Astro.url.pathname} variant={pageChrome.headerVariant} />
      <DeferredSearch />
      <main id="main-content">
        <slot />
      </main>
      <Footer />
    </div>
    <DeferredAIAssistant />

    <script>
      let cleanupRevealEnhancements: (() => void) | undefined;

      const enhanceReveals = () => {
        cleanupRevealEnhancements?.();
        const controller = new AbortController();
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const revealElements = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];

        if (reducedMotion) {
          revealElements.forEach((element) => element.classList.add('is-visible'));
        } else if (revealElements.length > 0) {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
          );
          revealElements.forEach((element) => {
            if (element.getBoundingClientRect().top < window.innerHeight * 0.92) {
              element.classList.add('is-visible');
            } else {
              element.classList.add('reveal-ready');
              observer.observe(element);
            }
          });
          cleanupRevealEnhancements = () => {
            controller.abort();
            observer.disconnect();
          };
          return;
        }

        cleanupRevealEnhancements = () => controller.abort();
      };

      document.addEventListener('astro:page-load', enhanceReveals);
    </script>
  </body>
</html>
