---
import { siteConfig } from '@/config/site';
import { githubUrl } from '@/config/profile';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-wide footer-grid">
    <div>
      <a class="footer-brand" href="/">LFW Space</a>
      <p>{siteConfig.footer.note}</p>
    </div>
    <div class="footer-links" aria-label="页脚导航">
      <a href="/rss.xml">RSS</a>
      <a href="/archive">归档</a>
      <a href="/series">系列</a>
      <a href="/tags">标签</a>
      <a href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>
    <p class="copyright">© {year} {siteConfig.author}. Built with Astro.</p>
  </div>
</footer>
