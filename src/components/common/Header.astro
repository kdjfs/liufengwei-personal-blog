---
import ThemeToggle from './ThemeToggle.astro';
import { githubUrl } from '@/config/profile';
import { siteConfig } from '@/config/site';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="site-header" data-header>
  <nav class="nav-wrap container-wide" aria-label="主导航">
    <a class="brand" href="/" aria-label="LFW Space 首页">
      <span>{siteConfig.shortName}</span>
      <i aria-hidden="true">✦</i>
    </a>

    <div class="desktop-nav">
      {
        siteConfig.nav.map((item) => (
          <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
            {item.label}
          </a>
        ))
      }
    </div>

    <div class="nav-actions">
      <button
        class="icon-button search-trigger"
        type="button"
        data-open-search
        aria-label="打开搜索"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path>
        </svg><kbd>⌘ K</kbd>
      </button>
      <ThemeToggle />
      <a
        class="icon-button github-link"
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 2.8a9.2 9.2 0 0 0-2.9 17.9c.5.1.6-.2.6-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 0 1.6 1.1 1.6 1.1.9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.7-1.4-2.2-.3-4.6-1.1-4.6-5a3.9 3.9 0 0 1 1-2.7c-.1-.3-.4-1.3.1-2.7 0 0 .9-.3 2.8 1a9.6 9.6 0 0 1 5.1 0c2-1.3 2.8-1 2.8-1 .6 1.4.2 2.4.1 2.7a3.9 3.9 0 0 1 1 2.7c0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.8v2.7c0 .3.2.6.7.5A9.2 9.2 0 0 0 12 2.8Z"
          ></path>
        </svg>
      </a>
      <button
        class="menu-button"
        type="button"
        data-menu-button
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span></span><span></span><span></span><span class="sr-only">打开导航</span>
      </button>
    </div>
  </nav>

  <div class="mobile-nav" id="mobile-nav" data-mobile-nav hidden>
    {
      siteConfig.nav.map((item) => (
        <a href={item.href} class:list={['mobile-nav-link', { active: isActive(item.href) }]}>
          {item.label}
        </a>
      ))
    }
  </div>
</header>

<script>
  let cleanupHeader: (() => void) | undefined;

  const setupHeader = () => {
    cleanupHeader?.();
    const controller = new AbortController();
    const header = document.querySelector<HTMLElement>('[data-header]');
    const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
    const menu = document.querySelector<HTMLElement>('[data-mobile-nav]');
    if (!header || !button || !menu) return;

    const updateHeader = () => header.classList.toggle('scrolled', window.scrollY > 12);
    window.addEventListener('scroll', updateHeader, {
      passive: true,
      signal: controller.signal,
    });
    updateHeader();

    button.addEventListener(
      'click',
      () => {
        const open = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!open));
        menu.hidden = open;
      },
      { signal: controller.signal },
    );
    menu.querySelectorAll('a').forEach((link) =>
      link.addEventListener(
        'click',
        () => {
          button.setAttribute('aria-expanded', 'false');
          menu.hidden = true;
        },
        { signal: controller.signal },
      ),
    );
    cleanupHeader = () => controller.abort();
  };

  document.addEventListener('astro:page-load', setupHeader);
</script>
