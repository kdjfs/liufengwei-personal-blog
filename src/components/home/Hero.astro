---
import { Image } from 'astro:assets';
import homeCover from '@/assets/blog-covers/15.png';
import { siteConfig } from '@/config/site';
---

<section class="home-cover" aria-labelledby="home-cover-title">
  <Image
    class="home-cover-image"
    src={homeCover}
    alt=""
    widths={[480, 800, 1080, 1440, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    format="webp"
  />
  <div class="home-cover-shade" aria-hidden="true"></div>
  <div class="home-cover-content">
    <p class="home-cover-brand">{siteConfig.name}</p>
    <h1 id="home-cover-title">{siteConfig.subtitle}</h1>
    <p class="home-cover-quote">= 把学习写成可以反复抵达的路径 =</p>
    <p class="home-cover-topics">FRONTEND · AI AGENT · LEARNING</p>
  </div>
  <svg class="home-cover-wave" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
    <path
      class="home-cover-wave-back"
      d="M0,44 C228,82 386,25 620,52 C862,80 1058,108 1440,42 L1440,120 L0,120 Z"></path>
    <path
      class="home-cover-wave-front"
      d="M0,70 C236,35 420,108 670,78 C910,49 1135,43 1440,79 L1440,120 L0,120 Z"></path>
  </svg>
</section>
