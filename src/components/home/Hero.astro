---
import { Image } from 'astro:assets';
import homeCover from '@/assets/blog-covers/15.png';
import { siteConfig } from '@/config/site';
---

<section class="home-cover" aria-labelledby="home-cover-title">
  <Image
    class="home-cover-image"
    src={homeCover}
    alt=""
    widths={[480, 800, 1080, 1440, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    decoding="sync"
    format="webp"
  />
  <div class="home-cover-shade" aria-hidden="true"></div>
  <div class="home-cover-content">
    <p class="home-cover-brand">{siteConfig.name}</p>
    <h1 id="home-cover-title">{siteConfig.subtitle}</h1>
    <p class="home-cover-quote">= 把学习写成可以反复抵达的路径 =</p>
    <p class="home-cover-topics">FRONTEND · AI AGENT · LEARNING</p>
  </div>
  <svg class="home-cover-wave" viewBox="0 0 180 34" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <path
        id="home-cover-gentle-wave"
        d="M-220,17 C-190,5 -160,5 -130,17 S-70,29 -40,17 S20,5 50,17 S110,29 140,17 S200,5 230,17 S290,29 320,17 S380,5 410,17 L410,36 L-220,36 Z"
      ></path>
    </defs>
    <use
      class="home-cover-wave-layer home-cover-wave-back"
      href="#home-cover-gentle-wave"
      x="0"
      y="-2"></use>
    <use
      class="home-cover-wave-layer home-cover-wave-front"
      href="#home-cover-gentle-wave"
      x="0"
      y="4"></use>
  </svg>
</section>
