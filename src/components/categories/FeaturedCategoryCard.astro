---
import { Image } from 'astro:assets';
import type { FeaturedCategory } from '@/config/categories';
import { getBlogCover } from '@/utils/blog-cover';

interface Props {
  category: FeaturedCategory;
  count: number;
  tags?: string[];
  priority?: boolean;
  revealDelay?: number;
}

const { category, count, tags = [], priority = false, revealDelay = 0 } = Astro.props;
const cover = getBlogCover(category.name, category.cover);
const href = `/categories/${encodeURIComponent(category.name)}`;
---

<a
  class="featured-category-card"
  href={href}
  aria-label={`浏览${category.name}分类，${count}篇文章`}
  data-reveal
  style={`--reveal-delay: ${revealDelay}ms`}
>
  <span class="featured-category-inner">
    <span class="featured-category-face featured-category-front">
      <Image
        src={cover.image}
        alt=""
        widths={[360, 540, 720]}
        sizes="(max-width: 680px) 92vw, (max-width: 1100px) 44vw, 300px"
        loading={priority ? 'eager' : 'lazy'}
        format="webp"
      />
      <span class="featured-category-shade" aria-hidden="true"></span>
      <span class="featured-category-front-copy">
        <span class="featured-category-index">CATEGORY</span>
        <strong>{category.name}</strong>
        <span>{count} ARTICLES</span>
      </span>
    </span>
    <span class="featured-category-face featured-category-back">
      <span class="featured-category-index">EXPLORE TOPIC</span>
      <strong>{category.name}</strong>
      <span class="featured-category-description">{category.description}</span>
      <span class="featured-category-count">{count} ARTICLES</span>
      {
        tags.length > 0 && (
          <span class="featured-category-tags">{tags.slice(0, 3).join(' / ')}</span>
        )
      }
      <span class="featured-category-action">Explore <i aria-hidden="true">→</i></span>
    </span>
  </span>
</a>
