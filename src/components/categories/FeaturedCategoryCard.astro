---
import { Image } from 'astro:assets';
import type { FeaturedCategory } from '@/config/categories';
import type { BlogEntry } from '@/utils/posts';
import { getPostSlug } from '@/utils/posts';
import { getBlogCover } from '@/utils/blog-cover';

interface Props {
  category: FeaturedCategory;
  count: number;
  latestPosts?: BlogEntry[];
  priority?: boolean;
  revealDelay?: number;
}

const { category, count, latestPosts = [], priority = false, revealDelay = 0 } = Astro.props;
const cover = getBlogCover(category.name, category.cover);
const href = `/categories/${encodeURIComponent(category.name)}`;
---

<article
  class="featured-category-card"
  aria-label={`${category.name}分类，${count}篇文章`}
  data-reveal
  style={`--reveal-delay: ${revealDelay}ms`}
>
  <span class="featured-category-inner">
    <span class="featured-category-face featured-category-front">
      <Image
        src={cover.image}
        alt=""
        widths={[480, 720, 960]}
        sizes="(max-width: 767px) 92vw, 45vw"
        loading={priority ? 'eager' : 'lazy'}
        format="webp"
      />
      <span class="featured-category-shade" aria-hidden="true"></span>
      <span class="featured-category-front-copy">
        <strong>{category.name}</strong>
        <span>{count} 篇文章</span>
      </span>
      <a class="featured-category-front-link" href={href} aria-label={`进入${category.name}分类`}
      ></a>
    </span>

    <span class="featured-category-face featured-category-back">
      <span class="featured-category-ribbon">{category.name}</span>
      <strong>最新文章</strong>
      {
        latestPosts.length > 0 ? (
          <span class="featured-category-posts">
            {latestPosts.map((post) => (
              <a href={`/blog/${getPostSlug(post)}`}>{post.data.title}</a>
            ))}
          </span>
        ) : (
          <span class="featured-category-empty">内容正在生长中</span>
        )
      }
      <span class="featured-category-footer">
        <span>{count} 篇文章</span>
        <a href={href}>more...</a>
      </span>
    </span>
  </span>
</article>
