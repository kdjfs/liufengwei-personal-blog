---
import SidebarIcon from './SidebarIcon.astro';
import SocialIcon from './SocialIcon.astro';
import { profile } from '@/config/profile';
import { siteConfig } from '@/config/site';

interface Props {
  stats: {
    articles: number;
    categories: number;
    tags: number;
    series: number;
  };
  currentPath?: string;
}

const { stats, currentPath = '/' } = Astro.props;
const statItems = [
  { value: stats.articles, label: '文章', href: '/blog' },
  { value: stats.categories, label: '分类', href: '/categories' },
  { value: stats.tags, label: '标签', href: '/tags' },
];
const navIcons = ['home', 'writing', 'learning', 'projects', 'timeline', 'about'] as const;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
---

<aside class="profile-rail" aria-labelledby="profile-name">
  <div class="profile-identity">
    <div class="profile-avatar-wrap">
      <img
        class="profile-avatar"
        src={profile.avatar}
        width="640"
        height="640"
        alt={`${profile.name}的头像`}
      />
      <span class="profile-status" title="正在持续学习与构建"><i></i> OPEN TO GROW</span>
    </div>
    <div class="profile-name-wrap">
      <p>{profile.englishName}</p>
      <h2 id="profile-name">{profile.name}</h2>
      <span>{profile.role}</span>
    </div>
  </div>

  <p class="profile-bio">{profile.bio}</p>

  <nav class="profile-socials" aria-label="个人社交链接">
    {
      profile.socials.map((social) => (
        <a
          href={social.href}
          aria-label={social.label}
          title={social.label}
          target={social.external ? '_blank' : undefined}
          rel={social.external ? 'noopener noreferrer' : undefined}
          data-social={social.icon}
        >
          <SocialIcon icon={social.icon} />
          <span>{social.label}</span>
        </a>
      ))
    }
  </nav>

  <div class="profile-stats" aria-label="内容统计">
    {
      statItems.map((stat) => (
        <a href={stat.href}>
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </a>
      ))
    }
  </div>

  <nav class="sidebar-nav" aria-label="首页侧栏导航">
    {
      siteConfig.nav.map((item, index) => (
        <a
          href={item.href}
          class:list={{ active: isActive(item.href) }}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          <SidebarIcon name={navIcons[index]} />
          <span>{item.label}</span>
        </a>
      ))
    }
  </nav>

  <details class="profile-experience" open>
    <summary class="profile-section-title">
      <span>经历</span>
      <small>最近 {profile.experiences.length} 段</small>
    </summary>
    <ol>
      {
        profile.experiences.map((experience) => (
          <li>
            <time>{experience.period}</time>
            <strong>{experience.shortOrganization}</strong>
            <span>{experience.summary}</span>
          </li>
        ))
      }
    </ol>
    <a class="experience-more" href="/about">完整经历 →</a>
  </details>
</aside>
